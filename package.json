{
  "name": "llm-traces-app",
  "version": "0.0.2",
  "description": "Grafana app plugin for visualizing LLM traces stored in Tempo",
  "license": "Apache-2.0",
  "author": "enki GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/enki-farm/llm-traces.git"
  },
  "homepage": "https://github.com/enki-farm/llm-traces",
  "bugs": {
    "url": "https://github.com/enki-farm/llm-traces/issues"
  },
  "keywords": [
    "grafana",
    "llm",
    "traces",
    "observability",
    "genai",
    "otel",
    "tempo"
  ],
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -c ./webpack.config.ts --env production",
    "dev": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -w -c ./webpack.config.ts --env development",
    "build:standalone": "webpack --config webpack.config.standalone.js --env production",
    "build:host": "npx --yes tsx scripts/build-host.mjs",
    "dev:host": "npx --yes tsx scripts/build-host.mjs --watch",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/llmUtils.unit.test.ts && node --import ./tests/node-loader.mjs --experimental-strip-types --no-warnings=ExperimentalWarning tests/tempoClient.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/costUtils.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/prism-traceql.unit.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "ts-loader": "9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.58.0",
    "webpack": "5.111.1",
    "webpack-cli": "5.1.4"
  },
  "peerDependencies": {
    "@grafana/data": ">=13.0.0",
    "@grafana/runtime": ">=13.0.0",
    "@grafana/ui": ">=13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "gpt-tokenizer": "^2.9.0",
    "marked": "^16.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
