{
  "name": "enki-llmtraces-app",
  "version": "0.0.1",
  "description": "Grafana app plugin for visualizing LLM traces stored in Tempo",
  "license": "Apache-2.0",
  "author": "enki GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/enki-farm/llm-traces.git"
  },
  "homepage": "https://github.com/enki-farm/llm-traces",
  "bugs": {
    "url": "https://github.com/enki-farm/llm-traces/issues"
  },
  "keywords": [
    "grafana",
    "llm",
    "traces",
    "observability",
    "genai",
    "otel",
    "tempo"
  ],
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -c ./webpack.config.ts --env production && node scripts/package-dist.mjs",
    "dev": "NODE_OPTIONS='--experimental-strip-types --no-warnings=ExperimentalWarning' webpack -w -c ./webpack.config.ts --env development",
    "build:standalone": "npm run build",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/llmUtils.unit.test.ts && node --import ./tests/node-loader.mjs --experimental-strip-types --no-warnings=ExperimentalWarning tests/tempoClient.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/costUtils.unit.test.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning tests/prism-traceql.unit.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "^1.16.13",
    "@types/node": "22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "imports-loader": "^5.0.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.58.0",
    "webpack": "5.111.1",
    "webpack-cli": "5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "peerDependencies": {
    "@grafana/data": ">=13.0.0",
    "@grafana/runtime": ">=13.0.0",
    "@grafana/ui": ">=13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "gpt-tokenizer": "^2.9.0",
    "marked": "^16.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
