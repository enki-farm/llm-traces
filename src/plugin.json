{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "LLMTraces",
  "id": "enki-llmtraces-app",
  "info": {
    "keywords": ["llm", "traces", "observability", "genai", "otel"],
    "description": "LLM trace visualization for OTel GenAI spans stored in Grafana Tempo",
    "author": { "name": "enki GmbH", "url": "https://github.com/enki-farm" },
    "links": [
      { "name": "Project repository", "url": "https://github.com/enki-farm/llm-traces" },
      { "name": "Documentation", "url": "https://github.com/enki-farm/llm-traces#readme" },
      { "name": "Issue tracker", "url": "https://github.com/enki-farm/llm-traces/issues" },
      { "name": "License", "url": "https://github.com/enki-farm/llm-traces/blob/main/LICENSE" }
    ],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "screenshots": [
      { "name": "LLMTraces", "path": "img/llm-traces-screenshot.png" }
    ],
    "version": "0.0.1",
    "updated": "2026-10-07"
  },
  "includes": [
    {
      "type": "page",
      "name": "LLMTraces",
      "path": "/a/enki-llmtraces-app",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true,
      "icon": "ai-sparkle"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.0.0",
    "plugins": []
  }
}