{
  "apiVersion": "v1",
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "LLM Traces",
  "id": "llm-traces-app",
  "info": {
    "keywords": ["llm", "traces", "observability", "genai", "otel"],
    "description": "LLM trace visualization for OTel GenAI spans stored in Grafana Tempo",
    "author": { "name": "enki GmbH", "url": "https://github.com/enki-farm" },
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "screenshots": [
      { "name": "LLM Traces", "path": "img/llm-traces-screenshot.png" }
    ],
    "version": "0.0.1",
    "updated": "2026-10-01"
  },
  "includes": [
    {
      "type": "page",
      "name": "LLM Traces",
      "path": "/a/llm-traces-app",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true,
      "icon": "ai-sparkle"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.0.0",
    "plugins": [
      {
        "type": "datasource",
        "id": "tempo",
        "name": "Tempo",
        "version": ">=0.3.0"
      }
    ]
  }
}
